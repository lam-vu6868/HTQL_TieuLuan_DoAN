# Dùng cho container Postgres (image tự đọc 3 biến này để tạo user + DB lần đầu)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=thesis_db

# Dùng cho FastAPI (async, driver asyncpg)
# Chú ý port cần trùng port cấu hình trong docker file
DATABASE_URL=postgresql+asyncpg://app_user:change_me@localhost:5432/thesis_db