# Cấu hình mẫu cho BE/app/config.py.
# 1. Sao chép thành BE/.env và điền thông tin PostgreSQL của máy phát triển.
# 2. Tạo JWT_SECRET ngẫu nhiên, đủ dài; không dùng chuỗi mẫu trong môi trường thật.
# 3. URL postgresql+psycopg:// hỗ trợ async khi database.py dùng create_async_engine().
# 4. Điền SMTP và địa chỉ FE khi triển khai email đặt lại mật khẩu; không lưu mật khẩu SMTP trong Git.
# 5. Không đưa BE/.env lên Git. config.py phải kiểm tra giá trị bắt buộc.
DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/httt07
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=example@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=example@example.com
PUBLIC_BASE_URL=http://localhost:5173
